# Copy to .env before running `docker compose up`

# Required for PDF data extraction (the rest of the app works without it)
OPENAI_API_KEY=your_openai_api_key

# Optional overrides
# OPENAI_MODEL=gpt-4o                         # quote extraction
# OPENAI_CLASSIFICATION_MODEL=gpt-4o-mini     # commodity group classification
# JWT_SECRET=generate-with-openssl-rand-hex-32
